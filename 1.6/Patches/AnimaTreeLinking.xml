<?xml version="1.0" encoding="utf-8"?>
<Patch>

	<Operation Class="PatchOperationReplace">
		<xpath>Defs/RitualBehaviorDef[defName="AnimaTreeLinking"]/roles</xpath>
		<value>
			<roles>
				<li Class="tsoa.core.TSOA_RitualRoleAnimaLinker">
					<label>linker</label>
					<id>organizer</id>
					<required>true</required>
					<maxCount>1</maxCount>
					<defaultForSelectedColonist>true</defaultForSelectedColonist>
					<noCandidatesGizmoDesc>Need a colonist that is not psychically deaf, and is not already at the maximum psylink level.</noCandidatesGizmoDesc>
					<allowChild>false</allowChild>
					<customChildDisallowMessage>Only adults can link with an anima tree.</customChildDisallowMessage>
				</li>
			</roles>
		</value>
	</Operation>

	<Operation Class="PatchOperationReplace">
		<xpath>Defs/RitualObligationTargetFilterDef[defName="AnimaTree"]/workerClass</xpath>
		<value>
			<workerClass>tsoa.core.TSOA_RitualObligationTargetWorker_AnimaTree</workerClass>
		</value>
	</Operation>
	
</Patch>