<?xml version="1.0" encoding="utf-8"?>
<Defs>

	<GenStepDef>
		<defName>TSOA_SilentAnimaTreesPlayerBase</defName>
		<order>1601</order>
		<genStep Class="tsoa.core.GenStep_SpawnThingsAroundThing">
			<focusThing>Plant_TreeAnima</focusThing>
			<spawnThing>TSOA_TreeAnimaSilent</spawnThing>
		</genStep>
	</GenStepDef>

	<GenStepDef>
		<defName>TSOA_SilentGrove</defName>
		<linkWithSite>TSOA_SilentGrove</linkWithSite>
		<order>900</order>
		<genStep Class="tsoa.core.GenStep_SilentGrove">
			<focusThing>TSOA_TreeAnimaDummy</focusThing>
			<spawnThing>TSOA_TreeAnimaSilent</spawnThing>
		</genStep>
	</GenStepDef>

	<GenStepDef>
		<defName>TSOA_AnomalyAmbush</defName>
		<linkWithSite>TSOA_AnomalyAmbush</linkWithSite>
		<order>1600</order>
		<genStep Class="tsoa.core.GenStep_AnomalyAmbush" />
	</GenStepDef>

	<SitePartDef>
		<defName>TSOA_SilentGrove</defName>
		<label>silent grove</label>
		<workerClass>tsoa.core.SitePartWorker_SilentGrove</workerClass>
		<description>A grove of silent anima trees</description>
		<!-- TODO custom icon -->
		<siteTexture>World/WorldObjects/Sites/GenericSite</siteTexture>
		<expandingIconTexture>TSOA/Things/Plant/DeadTreeAnima/DeadTreeAnimaA</expandingIconTexture>
		<forceExitAndRemoveMapCountdownDurationDays>11</forceExitAndRemoveMapCountdownDurationDays>
		<mainPartAllThreatsLabel>Hostile activity detected.</mainPartAllThreatsLabel>
		<gravShipsCanLandOn>false</gravShipsCanLandOn>
		<tags>
			<li>SilentGrove</li>
		</tags>
	</SitePartDef>

	<SitePartDef mayRequire="Ludeon.Rimworld.Anomaly">
		<defName>TSOA_AnomalyAmbush</defName>
		<label>anomaly ambush</label>
		<description>a group of hidden entities</description>
		<workerClass>tsoa.core.SitePartWorker_AnomalyAmbush</workerClass>
		<siteTexture>World/WorldObjects/Sites/GenericSite</siteTexture>
		<expandingIconTexture>World/WorldObjects/Expanding/Sites/SleepingPawns</expandingIconTexture>
		<arrivedLetter>Something doesn't feel right here.</arrivedLetter>
		<arrivedLetterDef>NegativeEvent</arrivedLetterDef>
		<wantsThreatPoints>true</wantsThreatPoints>
		<minThreatPoints>400</minThreatPoints>
		<tags>
			<li>AnomalyAmbush</li>
		</tags>
	</SitePartDef>

	<WorldObjectDef ParentName="StaticWorldObjectBase">
		<defName>TSOA_FontOfAnimaWorldObject</defName>
		<label>font of anima</label>
		<description>T</description>
		<worldObjectClass>tsoa.core.FontOfAnimaWorldObject</worldObjectClass>
		<texture>TSOA/UI/WorldObjects/AmberIcon</texture>
		<expandingIcon>true</expandingIcon>
		<expandingIconTexture>TSOA/UI/WorldObjects/AmberIcon</expandingIconTexture>
		<expandingIconPriority>50</expandingIconPriority>
		<IncidentTargetTags>
			<li>Map_Misc</li>
		</IncidentTargetTags>
		<mapGenerator>TSOA_FontOfAnimaMapGenerator</mapGenerator>
		<canBePlayerHome>true</canBePlayerHome>
		<comps>
			<li Class="WorldObjectCompProperties_Abandon" />
			<li Class="WorldObjectCompProperties_FormCaravan"/>
			<li Class="WorldObjectCompProperties_EnterCooldown" />
		</comps>
	</WorldObjectDef>

	<MapGeneratorDef ParentName="MapCommonBase">
		<defName>TSOA_FontOfAnimaMapGenerator</defName>
		<genSteps>
			<li>RocksFromGrid</li>
			<li>TSOA_FontOfAnimaGenStep</li>
			<li>TSOA_FontOfAnimaAnimaGrass</li>
			<li>TSOA_FontOfAnimaSilentTrees</li>
			<li>TSOA_FontOfAnimaDummyTrees</li>
		</genSteps>
	</MapGeneratorDef>
	
	<GenStepDef>
		<defName>TSOA_FontOfAnimaGenStep</defName>
		<order>420</order>
		<genStep Class="tsoa.core.GenStep_FontOfAnima">
		</genStep>
	</GenStepDef>

	<!-- Do this first, since later spawns from GenStep_SpawnThingsAroundThing can replace earlier ones-->
	<GenStepDef>
		<defName>TSOA_FontOfAnimaAnimaGrass</defName>
		<order>1600</order>
		<genStep Class="tsoa.core.GenStep_SpawnThingsAroundThing">
			<focusThing>TSOA_FontOfAnima</focusThing>
			<spawnThing>TSOA_GrassAnimaDummy</spawnThing>
			<spawnMin>100</spawnMin>
			<spawnMax>200</spawnMax>
			<maxRadius>16</maxRadius>
			<minDistanceBetweenThings>0</minDistanceBetweenThings>
		</genStep>
	</GenStepDef>

	<GenStepDef>
		<defName>TSOA_FontOfAnimaDummyTrees</defName>
		<order>1601</order>
		<genStep Class="tsoa.core.GenStep_SpawnThingsAroundThing">
			<focusThing>TSOA_FontOfAnima</focusThing>
			<spawnThing>TSOA_TreeAnimaDummy</spawnThing>
			<spawnMin>2</spawnMin>
			<spawnMax>4</spawnMax>
		</genStep>
	</GenStepDef>

	<GenStepDef>
		<defName>TSOA_FontOfAnimaSilentTrees</defName>
		<order>1602</order>
		<genStep Class="tsoa.core.GenStep_SpawnThingsAroundThing">
			<focusThing>TSOA_FontOfAnima</focusThing>
			<spawnThing>TSOA_TreeAnimaSilent</spawnThing>
			<spawnMin>4</spawnMin>
			<spawnMax>6</spawnMax>
		</genStep>
	</GenStepDef>

</Defs>