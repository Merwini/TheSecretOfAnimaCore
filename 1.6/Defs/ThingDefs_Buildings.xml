<?xml version="1.0" encoding="utf-8"?>
<Defs>
	
	<ThingDef ParentName="CrateBase">
		<defName>TSOA_AnimaSapBasin</defName>
		<label>anima sap basin</label>
		<description>A stone basin for collecting sap from an anima tree. When linked to a tree, it will siphon a portion of the pyschic meditation energy that is normally used to grow anima grass, and instead use it to make the tree produce extra sap which it immediately harvests.</description>
		<thingClass>tsoa.core.Building_AnimaSapBasin</thingClass>
		<graphicData>
			<texPath>TSOA/Things/Building/Basin/TSOA_BasinFull</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<drawSize>(1.4, 1.4)</drawSize>
			<shadowData>
				<volume>(1, 0.45, 2)</volume>
			</shadowData>
			<shaderType>CutoutComplex</shaderType>
		</graphicData>
		<size>(1, 1)</size>
		<fillPercent>0.40</fillPercent>
		<stuffCategories>
			<li>Stony</li>
		</stuffCategories>
		<costStuffCount>75</costStuffCount>
		<costList>
			<TSOA_AnimaGrassResource>5</TSOA_AnimaGrassResource>
		</costList>
		<statBases>
			<WorkToBuild>4500</WorkToBuild>
			<MaxHitPoints>200</MaxHitPoints>
			<Beauty>5</Beauty>
		</statBases>
		<researchPrerequisites>
			<li>TSOA_AnimaTwo</li>
		</researchPrerequisites>
		<altitudeLayer>Building</altitudeLayer>
		<passability>PassThroughOnly</passability>
		<pathCost>42</pathCost>
		<canOverlapZones>true</canOverlapZones>
		<tickerType>Rare</tickerType>
		<rotatable>false</rotatable>
		<comps>
			<li Class="tsoa.core.CompProperties_EmptyStateGraphicStuffed">
				<graphicData>
					<texPath>TSOA/Things/Building/Basin/TSOA_BasinEmpty</texPath>
					<graphicClass>Graphic_Single</graphicClass>
					<drawSize>(1.4, 1.4)</drawSize>
					<shaderType>CutoutComplex</shaderType>
				</graphicData>
			</li>
			<li Class="tsoa.core.CompProperties_GroupedFacility">
				<categoryTag>TSOA_AnimaBasinCategory</categoryTag>
				<mustBePlacedAdjacent>true</mustBePlacedAdjacent>
				<canPlaceWithoutLink>false</canPlaceWithoutLink>
			</li>
		</comps>
		<placeWorkers>
			<li>tsoa.core.PlaceWorker_ShowGroupedFacilitiesConnections</li>
		</placeWorkers>
		<building>
			<buildingTags>
				<li>Production</li>
			</buildingTags>
		</building>
		<designationCategory>Production</designationCategory>
	</ThingDef>

	<ThingDef ParentName="BuildingBase">
		<defName>TSOA_AnimaRootGrave</defName>
		<label>anima root grave</label>
		<description>A grave dug close to the roots of an anima tree. The roots connect to human bodies and absorb their lingering psychic prescence. This energizes the tree similarly to meditating around it, but rapidly decomposes the body. The bodies of more powerful psychics will have a more powerful effect.\n\nMust be built in range of an anima tree, and each tree can support a maximum of four graves.</description>
		<thingClass>tsoa.core.Building_RootGrave</thingClass>
		<containedPawnsSelectable>true</containedPawnsSelectable>
		<graphicData>
			<texPath>TSOA/Things/Building/RootGrave/TSOA_GraveEmpty</texPath>
			<graphicClass>Graphic_Multi</graphicClass>
			<drawSize>(3,4)</drawSize>
		</graphicData>
		<constructEffect>ConstructDirt</constructEffect>
		<altitudeLayer>FloorEmplacement</altitudeLayer>
		<useHitPoints>false</useHitPoints>
		<size>(1,2)</size>
		<tickerType>Rare</tickerType>
		<canOverlapZones>false</canOverlapZones>
		<statBases>
			<WorkToBuild>8000</WorkToBuild>
		</statBases>
		<researchPrerequisites>
			<li>TSOA_AnimaOne</li>
		</researchPrerequisites>
		<passability>Standable</passability>
		<defaultPlacingRot>South</defaultPlacingRot>
		<building>
			<ai_chillDestination>false</ai_chillDestination>
			<expandHomeArea>false</expandHomeArea>
			<isInert>true</isInert>
			<preventDeteriorationInside>true</preventDeteriorationInside>
			<haulToContainerDuration>500</haulToContainerDuration>
			<artificialForMeditationPurposes>false</artificialForMeditationPurposes>
			<isEscapableContainer>true</isEscapableContainer>
			<fullGraveGraphicData>
				<texPath>TSOA/Things/Building/RootGrave/TSOA_GraveFull</texPath>
				<graphicClass>Graphic_Multi</graphicClass>
				<drawSize>(3,4)</drawSize>
			</fullGraveGraphicData>
			<fixedStorageSettings>
				<filter>
					<categories>
						<li>CorpsesHumanlike</li>
					</categories>
				</filter>
			</fixedStorageSettings>
			<defaultStorageSettings>
				<priority>Important</priority>
				<filter>
					<categories>
						<li>CorpsesHumanlike</li>
					</categories>
				</filter>
			</defaultStorageSettings>
			<buildingTags>
				<li>RitualFocus</li>
			</buildingTags>
		</building>
		<inspectorTabs>
			<li>ITab_Storage</li>
		</inspectorTabs>
		<terrainAffordanceNeeded>Diggable</terrainAffordanceNeeded>
		<designationCategory>Misc</designationCategory>
		<uiOrder>2050</uiOrder>
		<designationHotKey>Misc8</designationHotKey>
		<comps>
			<li Class="CompProperties_AssignableToPawn">
				<drawAssignmentOverlay>false</drawAssignmentOverlay>
				<compClass>CompAssignableToPawn_Grave</compClass>
			</li>
			<li Class="tsoa.core.CompProperties_GroupedFacility">
				<categoryTag>TSOA_AnimaGraveCategory</categoryTag>
				<canPlaceWithoutLink>false</canPlaceWithoutLink>
			</li>
		</comps>
		<placeWorkers>
			<li>tsoa.core.PlaceWorker_ShowGroupedFacilitiesConnections</li>
		</placeWorkers>
		<ritualFocus>
			<spectateDistance>1</spectateDistance>
			<allowedSpectateSides>Vertical</allowedSpectateSides>
		</ritualFocus>
	</ThingDef>
</Defs>