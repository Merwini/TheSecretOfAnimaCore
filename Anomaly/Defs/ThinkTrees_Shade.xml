<?xml version="1.0" encoding="utf-8"?>
<Defs>

    <ThinkTreeDef>
        <defName>TSOA_Shade</defName>
        <thinkRoot Class="ThinkNode_Priority">
            <subNodes>
                <!-- Keep lying down when downed or receiving medical care. -->
                <li Class="ThinkNode_ConditionalMustKeepLyingDown">
                    <subNodes>
                        <li Class="ThinkNode_QueuedJob">
                            <inBedOnly>true</inBedOnly>
                        </li>
                        <li Class="JobGiver_KeepLyingDown" />
                    </subNodes>
                </li>
                <li Class="ThinkNode_Subtree">
                    <treeDef>Downed</treeDef>
                </li>
                <li Class="ThinkNode_Subtree">
                    <treeDef>BurningResponse</treeDef>
                </li>

                <li Class="ThinkNode_QueuedJob" />

                <!-- Retain the Ghoul's handling of drafted movement and caravan duties. -->
                <li Class="ThinkNode_ConditionalOfPlayerFaction">
                    <subNodes>
                        <li Class="ThinkNode_Tagger">
                            <tagToGive>DraftedOrder</tagToGive>
                            <subNodes>
                                <li Class="JobGiver_MoveToStandable" />
                                <li Class="JobGiver_Orders" />
                            </subNodes>
                        </li>
                    </subNodes>
                </li>
                <li Class="ThinkNode_Subtree">
                    <treeDef>LordDuty</treeDef>
                </li>

                <li Class="JobGiver_SeekAllowedArea" />
                <li Class="JobGiver_SeekSafeTemperature">
                    <requiresInjury>false</requiresInjury>
                    <waitInSafeTemp>false</waitInSafeTemp>
                    <maxRadius>15</maxRadius>
                </li>

                <li Class="ThinkNode_ConditionalOfPlayerFaction">
                    <subNodes>
                        <li Class="ThinkNode_Tagger">
                            <tagToGive>RestingForMedicalReasons</tagToGive>
                            <subNodes>
                                <li Class="JobGiver_PatientGoToBed">
                                    <urgentOnly>true</urgentOnly>
                                </li>
                            </subNodes>
                        </li>
                        <!-- Player-prioritized jobs and emergency work come before routine work. -->
                        <li Class="JobGiver_Work">
                            <emergency>true</emergency>
                        </li>
                    </subNodes>
                </li>

                <!-- Shades have a food need, but no rest, recreation, or mood needs. -->
                <li Class="ThinkNode_ConditionalOfPlayerFaction">
                    <subNodes>
                        <!-- Subhumans are not colonists; use faction membership here. -->
                        <li Class="ThinkNode_Tagger">
                            <tagToGive>SatisfyingNeeds</tagToGive>
                            <subNodes>
                                <li Class="ThinkNode_PrioritySorter">
                                    <subNodes>
                                        <li Class="JobGiver_GetFood" />
                                        <li Class="JobGiver_Work" />
                                    </subNodes>
                                </li>
                            </subNodes>
                        </li>
                    </subNodes>
                </li>
                <li Class="ThinkNode_Tagger">
                    <tagToGive>SatisfyingNeeds</tagToGive>
                    <subNodes>
                        <li Class="ThinkNode_PrioritySorter">
                            <subNodes>
                                <li Class="JobGiver_GetFood" />
                            </subNodes>
                        </li>
                    </subNodes>
                </li>

                <li Class="ThinkNode_Tagger">
                    <tagToGive>Idle</tagToGive>
                    <subNodes>
                        <li Class="JobGiver_WanderColony" />
                    </subNodes>
                </li>
                <li Class="JobGiver_IdleError" />
            </subNodes>
        </thinkRoot>
    </ThinkTreeDef>

    <ThinkTreeDef>
        <defName>TSOA_ShadeConstant</defName>
        <thinkRoot Class="ThinkNode_Priority">
            <subNodes>
                <li Class="ThinkNode_Subtree">
                    <treeDef>Despawned</treeDef>
                </li>
                <li Class="ThinkNode_ConditionalCanDoConstantThinkTreeJobNow">
                    <subNodes>
                        <li Class="JobGiver_FleePotentialExplosion" />
                        <!-- Flee nearby enemies instead of acquiring a combat target. -->
                        <li Class="JobGiver_FleeImmediateThreat">
                            <distToDangerToFlee>10</distToDangerToFlee>
                            <fleeDistRange>12~20</fleeDistRange>
                        </li>
                        <li Class="ThinkNode_Subtree">
                            <treeDef>JoinAutoJoinableCaravan</treeDef>
                        </li>
                    </subNodes>
                </li>
                <li Class="ThinkNode_ConditionalCanDoLordJobNow">
                    <subNodes>
                        <li Class="ThinkNode_Subtree">
                            <treeDef>LordDutyConstant</treeDef>
                        </li>
                    </subNodes>
                </li>
            </subNodes>
        </thinkRoot>
    </ThinkTreeDef>

</Defs>
