<?xml version="1.0" encoding="utf-8"?>
<Defs>

    <WorldObjectDef ParentName="StaticWorldObjectBase">
        <defName>TSOA_VoidTunnelExit</defName>
        <label>void tunnel exit</label>
        <description>An opening into the Void, anchored to a distant void gate.</description>
        <worldObjectClass>tsoa.core.anomaly.WorldObject_VoidTunnelExit</worldObjectClass>
        <texture>TSOA/Things/Building/VoidGate/VoidGatePLACEHOLDER</texture>
        <expandingIcon>true</expandingIcon>
        <expandingIconTexture>TSOA/Things/Building/VoidGate/VoidGatePLACEHOLDER</expandingIconTexture>
        <expandingIconPriority>50</expandingIconPriority>
        <canHaveMap>false</canHaveMap>
    </WorldObjectDef>

    <WorldObjectDef>
        <defName>TSOA_VoidTunnelCaravan</defName>
        <label>void tunnel caravan</label>
        <description>A caravan traveling through a void tunnel.</description>
        <worldObjectClass>tsoa.core.anomaly.WorldObject_VoidTunnelCaravan</worldObjectClass>
        <texture>World/WorldObjects/Caravan</texture>
        <useDynamicDrawer>true</useDynamicDrawer>
        <expandingIcon>true</expandingIcon>
        <expandingIconTexture>World/WorldObjects/Expanding/Caravan</expandingIconTexture>
        <expandingIconPriority>100</expandingIconPriority>
        <expandMore>true</expandMore>
        <canHaveMap>false</canHaveMap>
        <validLaunchTarget>false</validLaunchTarget>
        <allowCaravanIncidentsWhichGenerateMap>false</allowCaravanIncidentsWhichGenerateMap>
    </WorldObjectDef>

    <WorldObjectDef ParentName="StaticWorldObjectBase">
        <defName>TSOA_VoidTunnelAmbushSite</defName>
        <label>void tunnel ambush</label>
        <description>A caravan has been ambushed on its way through a void tunnel.</description>
        <worldObjectClass>tsoa.core.anomaly.WorldObject_VoidTunnelAmbush</worldObjectClass>
        <mapGenerator>TSOA_VoidTunnelAmbush</mapGenerator>
        <texture>World/WorldObjects/Ambush</texture>
        <expandingIcon>true</expandingIcon>
        <expandingIconTexture>World/WorldObjects/Expanding/Ambush</expandingIconTexture>
        <expandingIconPriority>80</expandingIconPriority>
        <expandMore>true</expandMore>
        <canHaveMap>true</canHaveMap>
        <isTempIncidentMapOwner>true</isTempIncidentMapOwner>
        <blockExitGridUntilBattleIsWon>true</blockExitGridUntilBattleIsWon>
        <validLaunchTarget>false</validLaunchTarget>
    </WorldObjectDef>
</Defs>
