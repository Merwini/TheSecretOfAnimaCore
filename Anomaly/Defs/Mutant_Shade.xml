  </EntityCodexEntryDef>

<RecipeDef ParentName="SurgeryFlesh">
    <defName>TSOA_ShadeInfusion</defName>
    <label>shade infusion</label>
    <description>Infuse a living person with bioferrite to create a creature known as a shade. Shades are mindless and disposable workers, that decay over time. They eat raw meat to survive but never sleep.\n\nShades created by this operation will be a part of your colony.</description>
    <workerClass>tsoa.core.Recipe_ShadeInfusion</workerClass>
    <recipeUsers>
        <li>Human</li>
    </recipeUsers>
    <jobString>Shading TargetA.</jobString>
    <workAmount>2000</workAmount>
    <hideBodyPartNames>true</hideBodyPartNames>
    <targetsBodyPart>false</targetsBodyPart>
    <isViolation>true</isViolation>
    <anesthetize>false</anesthetize>
    <surgeryOutcomeEffect IsNull="True" /> <!-- Always succeeds -->
    <deathOnFailedSurgeryChance>0</deathOnFailedSurgeryChance>
    <skillRequirements>
        <Medicine>4</Medicine>
    </skillRequirements>
    <researchPrerequisites>
        <li>TSOA_VoidOne</li>
    </researchPrerequisites>
    <ingredients>
        <li>
            <filter>
            <thingDefs>
                <li>Bioferrite</li>
            </thingDefs>
            </filter>
            <count>30</count>
        </li>
    </ingredients>
    <fixedIngredientFilter>
        <thingDefs>
            <li>Bioferrite</li>
        </thingDefs>
    </fixedIngredientFilter>
</RecipeDef>

</Defs>
