    <ThoughtDef>
        <defName>TSOA_BecameShade</defName>
        <durationDays>20.0</durationDays>
        <stackLimit>5</stackLimit>
        <stackLimitForSameOtherPawn>1</stackLimitForSameOtherPawn>
        <nullifyingTraits>
            <li>Psychopath</li>
        </nullifyingTraits>
        <nullifyingHediffs>
            <li>Inhumanized</li>
        </nullifyingHediffs>
        <ignoreSubhumans>false</ignoreSubhumans>
        <stages>
            <li>
                <label>{0} became a shade</label>
                <description>That vacant look... Are they even in there anymore?</description>
                <baseMoodEffect>-6</baseMoodEffect>
            </li>
        </stages>
    </ThoughtDef>

