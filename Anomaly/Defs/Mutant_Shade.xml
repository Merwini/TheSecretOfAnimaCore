<Defs>

    <MutantDef ParentName="BaseMutantEntity">
        <defName>TSOA_ShadeMutant</defName>
        <label>shade</label>
        <description>A person who has been turned into a shade.\n\nAbout shades: Shades are fading vestiges of what was once human.\n\nUnlike ghouls, shades are harmless and nonviolent, having been engineered for menial labor. Designed to be disposable, their bodies and minds will degrade over time, and they are quite fragile. They will work without thought or complaint, but complex tasks are impossible for their crumbling minds.</description>
        <hediff>TSOA_ShadeHediff</hediff>
        <thinkTree>TSOA_Shade</thinkTree>
        <thinkTreeConstant>TSOA_ShadeConstant</thinkTreeConstant>
        <showJobReport>true</showJobReport>
        <disableApparel>true</disableApparel>
        <whitelistedFloatMenuProviders Inherit="False">
            <!-- Movement and manual work. -->
            <li>FloatMenuOptionProvider_DraftedMove</li>
            <li>FloatMenuOptionProvider_WorkGivers</li>
            <li>FloatMenuOptionProvider_CleanRoom</li>
            <li>FloatMenuOptionProvider_OpenThing</li>
            <li>FloatMenuOptionProvider_ExtinguishFires</li>
            <li>FloatMenuOptionProvider_PutOutFireOnPawn</li>

            <!-- Food and carrying injured pawns. -->
            <li>FloatMenuOptionProvider_Ingest</li>
            <li>FloatMenuOptionProvider_RescuePawn</li>
            <li>FloatMenuOptionProvider_CarryingPawn</li>
            <li>FloatMenuOptionProvider_CarryPawnToExit</li>

            <!-- Loading and travel. -->
            <li>FloatMenuOptionProvider_LoadCaravan</li>
            <li>FloatMenuOptionProvider_LoadOntoPackAnimal</li>
            <li>FloatMenuOptionProvider_CarryToShuttle</li>
            <li>FloatMenuOptionProvider_EnterMapPortal</li>

            <!-- Options supplied by individual things, comps, and zones. -->
            <li>FloatMenuOptionProvider_FromThing</li>
            <li>FloatMenuOptionProvider_FromZone</li>
        </whitelistedFloatMenuProviders>
        <workDisables Inherit="False">
            <li>Violent</li>
            <li>Shooting</li>
            <li>Social</li>
            <li>Caring</li>
            <li>Artistic</li>
            <li>Crafting</li>
            <li>Intellectual</li>
        </workDisables>
        <canCarryPawns>true</canCarryPawns>
        <relativeTurnedThought>TSOA_BecameShade</relativeTurnedThought>
        <allowedDevelopmentalStages>Adult</allowedDevelopmentalStages><needWhitelist>
            <li>Food</li>
        </needWhitelist>
        <overrideFoodType>true</overrideFoodType>
        <foodType>CarnivoreAnimalStrict</foodType>
        <allowEatingCorpses>true</allowEatingCorpses>
        <deathOnDownedChance>0.5</deathOnDownedChance>
        <removePermanentInjuries>true</removePermanentInjuries>
        <canUseDrugs>true</canUseDrugs>
        <drugWhitelist>
            <li>GhoulResurrectionSerum</li>
        </drugWhitelist>
        <anomalyKnowledgeOffset>0.1</anomalyKnowledgeOffset>
        <knowledgeCategory>Basic</knowledgeCategory>
        <codexEntry>TSOA_ShadeCodex</codexEntry>
        <givesHediffs>
            <li>
                <def>Regeneration</def>
                <severity>0.1</severity>
            </li>
        </givesHediffs>
        <disablesGenes>
            <li MayRequire="Ludeon.RimWorld.Biotech">Furskin</li>
        </disablesGenes>
        <deathLetter>One of your shades has died.</deathLetter>
        <deathLetterExtra>Unlike regular colonists, shades do not need to be buried and their death will not upset others. You may choose to bury them should you wish.</deathLetterExtra>
        <!-- Sounds -->
        <soundAttackChance>0.25</soundAttackChance>
        <soundCall>Pawn_Ghoul_Call</soundCall>
        <soundAttack>Pawn_Ghoul_Attack</soundAttack>
        <soundWounded>Pawn_Ghoul_Pain</soundWounded>
        <soundDeath>Pawn_Ghoul_Killed</soundDeath>
        <!-- Rendering -->
        <skinColorOverride>(0.6, 0.66, 0.76)</skinColorOverride>
        <hairColorOverride>(0.65, 0.65, 0.65)</hairColorOverride>
        <bodyTypeGraphicPaths>
            <Male>Things/Pawn/Ghoul/Bodies/Ghoulskin_Male</Male>
            <Female>Things/Pawn/Ghoul/Bodies/Ghoulskin_Female</Female>
            <Hulk>Things/Pawn/Ghoul/Bodies/Ghoulskin_Hulk</Hulk>
            <Fat>Things/Pawn/Ghoul/Bodies/Ghoulskin_Fat</Fat>
            <Thin>Things/Pawn/Ghoul/Bodies/Ghoulskin_Thin</Thin>
        </bodyTypeGraphicPaths>
        <forcedHeadTypes>
            <li>Ghoul_Normal</li>
            <li>Ghoul_Heavy</li>
            <li>Ghoul_Narrow</li>
            <li MayRequire="Ludeon.RimWorld.Biotech">Ghoul_Wide</li>
        </forcedHeadTypes>
        <hairTagFilter>
            <whitelist>true</whitelist>
            <tags>
                <li>Ghoul</li>
            </tags>
        </hairTagFilter>
        <beardTagFilter>
            <whitelist>true</whitelist>
            <tags>
                <li>NoBeard</li>
            </tags>
        </beardTagFilter>

        <tools>
            <li>
                <label>teeth</label>
                <capacities>
                    <li>Bite</li>
                </capacities>
                <power>3.2</power>
                <cooldownTime>2</cooldownTime>
                <linkedBodyPartsGroup>Teeth</linkedBodyPartsGroup>
                <chanceFactor>0.5</chanceFactor>
                <soundMeleeHit>Pawn_Melee_HumanBite_Hit</soundMeleeHit>
                <soundMeleeMiss>Pawn_Melee_HumanBite_Miss</soundMeleeMiss>
            </li>
            <li>
                <label>left claw</label>
                <labelNoLocation>claw</labelNoLocation>
                <capacities>
                    <li>Scratch</li>
                </capacities>
                <power>2.0</power>
                <cooldownTime>2</cooldownTime>
                <linkedBodyPartsGroup>LeftHand</linkedBodyPartsGroup>
                <chanceFactor>1.5</chanceFactor>
                <alwaysTreatAsWeapon>true</alwaysTreatAsWeapon>
                <soundMeleeHit>Pawn_Ghoul_Scratch</soundMeleeHit>
                <soundMeleeMiss>Pawn_Melee_SmallScratch_Miss</soundMeleeMiss>
            </li>
            <li>
                <label>right claw</label>
                <labelNoLocation>claw</labelNoLocation>
                <capacities>
                    <li>Scratch</li>
                </capacities>
                <power>2.0</power>
                <cooldownTime>2</cooldownTime>
                <linkedBodyPartsGroup>RightHand</linkedBodyPartsGroup>
                <chanceFactor>1.5</chanceFactor>
                <alwaysTreatAsWeapon>true</alwaysTreatAsWeapon>
                <soundMeleeHit>Pawn_Ghoul_Scratch</soundMeleeHit>
                <soundMeleeMiss>Pawn_Melee_SmallScratch_Miss</soundMeleeMiss>
            </li>
        </tools>
    </MutantDef>

