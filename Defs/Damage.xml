<Defs>
	
	<!-- Should never actually have damage applied with this def, DamageWorker will convert it into a different damage -->
	<DamageDef>
		<defName>TSOA_EntropyExtraDamage</defName>
		<label>psychic burn</label>
		<workerClass>tsoa.core.DamageWorker_EntropyExtraDamage</workerClass>
		<armorCategory>Sharp</armorCategory>
		<hediff>Burn</hediff>
		<defaultDamage>1</defaultDamage>
		<externalViolence>true</externalViolence>
	</DamageDef>

	<DamageDef>
		<defName>TSOA_EntropicDischarge</defName>
		<label>entropic discharge</label>
		<externalViolence>true</externalViolence>
		<workerClass>DamageWorker_AddInjury</workerClass>
		<hediff>TSOA_EntropicDischarge_Injury</hediff>
		<hediffSkin>TSOA_EntropicDischarge_Skin</hediffSkin>
		<hediffSolid>TSOA_EntropicDischarge_Solid</hediffSolid>
		<deathMessage>{0} has died from discharged neural heat.</deathMessage>
	</DamageDef>

	<!-- Damage should not actually be applied, worker will just apply thought -->
	<DamageDef>
		<defName>TSOA_AnimaScreamer</defName>
		<label>anima scream</label>
		<workerClass>tsoa.core.DamageWorker_Screamer</workerClass>
		<hediff>Burn</hediff>
		<defaultDamage>1</defaultDamage>
		<externalViolence>true</externalViolence>
		<soundExplosion>TSOA_AnimaScreamer</soundExplosion>
		<ignoreShields>true</ignoreShields>
	</DamageDef>

	<!-- Another one that doesn't actually apply damage, just a vessel for the worker to do something -->
	<DamageDef>
		<defName>TSOA_PsychicLeech</defName>
		<label>psychic leech</label>
		<workerClass>tsoa.core.DamageWorker_PsychicLeech</workerClass>
		<hediff>Burn</hediff>
		<defaultDamage>1</defaultDamage>
		<externalViolence>true</externalViolence>
		<ignoreShields>true</ignoreShields>
	</DamageDef>
	
</Defs>