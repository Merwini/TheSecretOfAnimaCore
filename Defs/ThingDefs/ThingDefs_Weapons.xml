	<!-- Anima Tomahawk -->
	<ThingDef ParentName="BaseMeleeWeapon_Sharp_Quality">
		<defName>TSOA_AnimaTomahawk</defName>
		<label>acolyte hatchet</label>
		<description>A hatchet made to channel the psychic energy of its wielder into destructive force. The haft is carved from anima tree bark and wrapped in anima grass, forming a psychic connection between the wielder and the jade blade set in the head. When wielded by a psycaster, utilizes built-up neural heat to deal additional damage with every strike.</description>
		<graphicData>
			<texPath>TSOA/Things/Weapons/AnimaTomahawk</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<drawSize>(1.1, 1.1)</drawSize>
		</graphicData>
		<equippedAngleOffset>0</equippedAngleOffset>
		<uiIconScale>1.2</uiIconScale>
		<techLevel>Medieval</techLevel>
		<relicChance>2</relicChance>

		<statBases>
			<MaxHitPoints>120</MaxHitPoints>
			<WorkToMake>12000</WorkToMake>
			<Mass>1</Mass>
		</statBases>

		<costList>
			<TSOA_AnimaGrassResource>10</TSOA_AnimaGrassResource>
			<TSOA_AnimaBark>1</TSOA_AnimaBark>
			<Jade>10</Jade>
			<Steel>10</Steel>
		</costList>
		<recipeMaker>
			<researchPrerequisite>TSOA_AcolyteWeapons</researchPrerequisite>
			<unfinishedThingDef>UnfinishedWeapon</unfinishedThingDef>
			<skillRequirements>
				<Crafting>4</Crafting>
			</skillRequirements>
			<displayPriority>279</displayPriority>
		</recipeMaker>

		<tools>
			<li>
				<label>handle</label>
				<capacities>
					<li>Poke</li>
				</capacities>
				<power>9</power>
				<cooldownTime>2</cooldownTime>
			</li>
			<li>
				<label>edge</label>
				<capacities>
					<li>Cut</li>
				</capacities>
				<power>14</power>
				<cooldownTime>1.6</cooldownTime>
        		<armorPenetration>0.25</armorPenetration>
				<extraMeleeDamages>
					<li>
						<def>TSOA_EntropyExtraDamage</def>
						<amount>1</amount>
					</li>
				</extraMeleeDamages>
			</li>
		</tools>

		<weaponTags>
			<li>TSOA_AnimaWeaponsBasic</li>
		</weaponTags>
		<weaponClasses>
			<li>Neolithic</li>
		</weaponClasses>
		<modExtensions>
			<li Class="tsoa.core.PsyLinkRecipeExtension">
				<minPsylinkLevel>1</minPsylinkLevel>
			</li>
			<li Class="tsoa.core.EntropyDamageExtension">
				<damageDef>TSOA_EntropicDischarge</damageDef>
				<entropyCountedPercent>0.1</entropyCountedPercent>
				<damagePerEntropy>2</damagePerEntropy>
			</li>
		</modExtensions>
	</ThingDef>

