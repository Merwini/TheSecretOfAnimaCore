	<ThingDef ParentName="BuildingBase" Abstract="True" Name="TSOA_AnimusTotemBase">
		<graphicData>
			<graphicClass>Graphic_Single</graphicClass>
			<drawSize>(2, 2)</drawSize>
			<shadowData>
				<volume>(0.2, 0.35, 0.13)</volume>
				<offset>(0,0,-0.25)</offset>
			</shadowData>
			<drawOffset>(0,0,0.5)</drawOffset>
			<shaderType>CutoutComplex</shaderType>
		</graphicData>
		<statBases>
			<MaxHitPoints>450</MaxHitPoints>
			<Flammability>0</Flammability>
			<Beauty>10</Beauty>
			<WorkToBuild>16000</WorkToBuild>
			<Mass>300</Mass>
		</statBases>
		<designationCategory>TSOA_DesignationCategory</designationCategory>
		<stuffCategories>
			<li>Stony</li>
		</stuffCategories>
		<costStuffCount>200</costStuffCount>
		<costList>
			<Jade>25</Jade>
			<TSOA_AnimaSap>3</TSOA_AnimaSap>
		</costList>
		<minifiedDef>MinifiedThing</minifiedDef>
		<!-- <designatorDropdown>TSOA_AnimusTotemsDropdown</designatorDropdown> -->
		<thingCategories>
			<li>BuildingsMisc</li>
		</thingCategories>
		<building>
			<isEdifice>true</isEdifice>
		</building>
		<thingClass>tsoa.core.Building_AnimusTotem</thingClass>
		<size>(1, 1)</size>
		<fillPercent>1</fillPercent>
		<altitudeLayer>Building</altitudeLayer>
		<passability>PassThroughOnly</passability>
		<pathCost>42</pathCost>
		<canOverlapZones>true</canOverlapZones>
		<tickerType>Normal</tickerType>
		<drawerType>MapMeshAndRealTime</drawerType>
		<defaultPlacingRot>North</defaultPlacingRot>
		<comps>
			<li Class="tsoa.core.CompProperties_Facility_Grouped">
				<categoryTag>TSOA_AnimusTotemCategory</categoryTag>
				<maxDistance>6</maxDistance>
				<canPlaceWithoutLink>false</canPlaceWithoutLink>
			</li>
		</comps>
		<placeWorkers>
			<li>tsoa.core.PlaceWorker_ShowGroupedFacilitiesConnections</li>
		</placeWorkers>
	</ThingDef>

	<ThingDef ParentName="TSOA_AnimusTotemBase" Abstract="True" Name="TSOA_AnimusTotemGrass">
		<comps>
			<li Class="CompProperties_Refuelable">
				<fuelConsumptionRate>0.06667</fuelConsumptionRate>
				<fuelCapacity>1.0</fuelCapacity>
				<fuelMultiplier>1</fuelMultiplier>
				<fuelFilter>
					<thingDefs>
						<li>TSOA_AnimaGrassResource</li>
					</thingDefs>
				</fuelFilter>
				<showAllowAutoRefuelToggle>true</showAllowAutoRefuelToggle>
			</li>
		</comps>
	</ThingDef>

	<ThingDef ParentName="TSOA_AnimusTotemBase" Abstract="True" Name="TSOA_AnimusTotemSap">
		<comps>
			<li Class="CompProperties_Refuelable">
				<fuelConsumptionRate>0.06667</fuelConsumptionRate>
				<fuelCapacity>1.0</fuelCapacity>
				<fuelMultiplier>1</fuelMultiplier>
				<fuelFilter>
					<thingDefs>
						<li>TSOA_AnimaSap</li>
					</thingDefs>
				</fuelFilter>
				<showAllowAutoRefuelToggle>true</showAllowAutoRefuelToggle>
			</li>
		</comps>
	</ThingDef>

	<ThingDef ParentName="TSOA_AnimusTotemGrass">
		<defName>TSOA_TotemFriendship</defName>
		<label>animus totem of friendship</label>
		<description>A totem of carved stone and jade, lacquered with anima sap. When linked to an anima tree and fueled with anima grass, taps into the anima radix to emit a worldwide psychic signal. This signal subtly influences other factions to view your colony more favorably.\n\nFor non-permanently hostile factions, increases goodwill by 2 per day, up to a cap of 100 over their natural goodwill.</description>
		<thingClass>tsoa.core.Building_TotemFriendship</thingClass>
		<graphicData>
			<texPath>TSOA/Things/Building/Totem/AnimusTotemCapybara</texPath>
		</graphicData>
		<researchPrerequisites>
			<li>TSOA_AnimaTwo</li>
		</researchPrerequisites>
	</ThingDef>

	<ThingDef ParentName="TSOA_AnimusTotemGrass">
		<defName>TSOA_TotemMemory</defName>
		<label>animus totem of memory</label>
		<description>A totem of carved stone and jade, lacquered with anima sap. When linked to an anima tree and fueled with anima grass, taps into the anima radix to emit a worldwide psychic signal. This signal subtly influences your colonists, reminding them of good memories and distracting them from bad ones.\n\nFor your colonists, shortens the duration of negative thoughts by 50%, increases the duration of positive ones by 50%.</description>
		<thingClass>tsoa.core.Building_TotemMemory</thingClass>
		<graphicData>
			<texPath>TSOA/Things/Building/Totem/AnimusTotemElephant</texPath>
		</graphicData>
		<researchPrerequisites>
			<li>TSOA_TotemOne</li>
		</researchPrerequisites>
	</ThingDef>

	<ThingDef ParentName="TSOA_AnimusTotemGrass">
		<defName>TSOA_TotemObedience</defName>
		<label>animus totem of obedience</label>
		<description>A totem of carved stone and jade, lacquered with anima sap. When linked to an anima tree and fueled with anima grass, taps into the anima radix's worldwide psychic field to create a low-level psychic link between your colonists and their animals.\n\nWhile active, increases the trainability of all your animals by one level (none to intermediate, intermediate to advanced).</description>
		<thingClass>tsoa.core.Building_TotemObedience</thingClass>
		<graphicData>
			<texPath>TSOA/Things/Building/Totem/AnimusTotemDog</texPath>
		</graphicData>
		<researchPrerequisites>
			<li>TSOA_TotemOne</li>
		</researchPrerequisites>
	</ThingDef>

	<ThingDef ParentName="TSOA_AnimusTotemGrass">
		<defName>TSOA_TotemBounty</defName>
		<label>animus totem of bounty</label>
		<description>A totem of carved stone and jade, lacquered with anima sap. When linked to an anima tree and fueled with anima grass, taps into the anima radix to emit a map psychic signal. This signal stimulates plants to grow faster.\n\nIncreases the growth speed of all plants on the same map as the totem by 50%.</description>
		<thingClass>tsoa.core.Building_TotemBounty</thingClass>
		<graphicData>
			<texPath>TSOA/Things/Building/Totem/AnimusTotemCow</texPath>
		</graphicData>
		<researchPrerequisites>
			<li>TSOA_TotemOne</li>
		</researchPrerequisites>
	</ThingDef>

