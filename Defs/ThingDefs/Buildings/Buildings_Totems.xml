	<ThingDef ParentName="TSOA_AnimusTotemSap">
		<defName>TSOA_TotemBloodthirst</defName>
		<label>animus totem of bloodthirst</label>
		<description>A totem of carved stone and jade, lacquered with anima sap. When connected to an anima tree and fueled with anima sap, taps into the anima radix to collect the psychic energy released when a life is taken, and directs it into the colonist that took the life.\n\nGives a short-lived combat bonus. Every kill resets the timer and grows the bonus, to a maximum of 10 stacks.</description>
		<thingClass>tsoa.core.Building_TotemBloodthirst</thingClass>
		<graphicData>
			<texPath>TSOA/Things/Building/Totem/AnimusTotemShark</texPath>
		</graphicData>
		<researchPrerequisites>
			<li>TSOA_AnimaThree</li>
		</researchPrerequisites>
	</ThingDef>

