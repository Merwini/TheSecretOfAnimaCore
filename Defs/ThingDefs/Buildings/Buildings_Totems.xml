	<ThingDef ParentName="TSOA_AnimusTotemSap">
		<defName>TSOA_TotemReflex</defName>
		<label>animus totem of reflex</label>
		<description>A totem of carved stone and jade, lacquered with anima sap. When connected to an anima tree and fueled with anima sap, channels a psychic warning through the anima radix when danger strikes nearby.\n\nTriples all colonists' movement speed on the same map for 60 seconds when certain hostile events occur.</description>
		<thingClass>tsoa.core.Building_TotemReflex</thingClass>
		<graphicData>
			<texPath>TSOA/Things/Building/Totem/AnimusTotemCat</texPath>
		</graphicData>
		<researchPrerequisites>
			<li>TSOA_TotemTwo</li>
		</researchPrerequisites>
	</ThingDef>

	<ThingDef ParentName="TSOA_AnimusTotemSap">
		<defName>TSOA_TotemVersatility</defName>
		<label>animus totem of versatility</label>
		<description>A totem of carved stone and jade, lacquered with anima sap. When linked to an anima tree and fueled with anima sap, channels knowledge from the anima radix to help colonists learn unfamiliar skills.\n\nAll colonists on the same map gain at least 100% skill experience from passion, before other learning modifiers. Higher passion learning rates are preserved.</description>
		<thingClass>tsoa.core.Building_TotemVersatility</thingClass>
		<graphicData>
			<texPath>TSOA/Things/Building/Totem/AnimusTotemMonkey</texPath>
		</graphicData>
		<researchPrerequisites>
			<li>TSOA_TotemTwo</li>
		</researchPrerequisites>
	</ThingDef>

	<ThingDef ParentName="TSOA_AnimusTotemSap">
		<defName>TSOA_TotemDiscovery</defName>
		<label>animus totem of discovery</label>
		<description>A totem of carved stone and jade, lacquered with anima sap. When linked to an anima tree and fueled with anima sap, raises awareness of distant surroundings.\n\nWhile fueled, spawns an Item Stash quest every 1.5 - 3.5 days.</description>
		<thingClass>tsoa.core.Building_TotemDiscovery</thingClass>
		<graphicData>
			<texPath>TSOA/Things/Building/Totem/AnimusTotemEagle</texPath>
		</graphicData>
		<researchPrerequisites>
			<li>TSOA_TotemTwo</li>
		</researchPrerequisites>
	</ThingDef>

