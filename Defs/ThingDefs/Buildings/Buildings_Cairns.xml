	<ThingDef ParentName="BuildingBase" Abstract="True" Name="TSOA_AnimusCairnBase">
		<graphicData>
			<graphicClass>Graphic_Single</graphicClass>
			<drawSize>(1.25, 1.25)</drawSize>
			<shaderType>CutoutComplex</shaderType>
		</graphicData>
		<statBases>
			<MaxHitPoints>250</MaxHitPoints>
			<Flammability>0</Flammability>
			<Beauty>5</Beauty>
			<WorkToBuild>4000</WorkToBuild>
			<Mass>75</Mass>
		</statBases>
		<designationCategory>TSOA_DesignationCategory</designationCategory>
		<stuffCategories>
			<li>Stony</li>
		</stuffCategories>
		<costStuffCount>60</costStuffCount>
		<costList>
			<Jade>15</Jade>
			<TSOA_AnimaGrassResource>5</TSOA_AnimaGrassResource>
			<TSOA_AnimaBark>1</TSOA_AnimaBark>
		</costList>
		<minifiedDef>MinifiedThing</minifiedDef>
		<!-- <designatorDropdown>TSOA_AnimusCairnsDropdown</designatorDropdown> -->
		<thingCategories>
			<li>BuildingsMisc</li>
		</thingCategories>
		<building>
			<isEdifice>true</isEdifice>
		</building>
		<thingClass>tsoa.core.Building_AnimusCairn</thingClass>
		<size>(1, 1)</size>
		<fillPercent>0.40</fillPercent>
		<altitudeLayer>Building</altitudeLayer>
		<passability>PassThroughOnly</passability>
		<pathCost>42</pathCost>
		<canOverlapZones>true</canOverlapZones>
		<tickerType>Rare</tickerType>
		<comps>
			<li Class="tsoa.core.CompProperties_Facility_Grouped">
				<categoryTag>TSOA_AnimusCairnCategory</categoryTag>
				<maxDistance>5</maxDistance>
				<canPlaceWithoutLink>false</canPlaceWithoutLink>
			</li>
		</comps>
		<placeWorkers>
			<li>tsoa.core.PlaceWorker_ShowGroupedFacilitiesConnections</li>
		</placeWorkers>
	</ThingDef>

	<!-- Job Specific -->

	<ThingDef ParentName="TSOA_AnimusCairnBase">
		<defName>TSOA_CairnMining</defName>
		<label>animus cairn of excavation</label>
		<description>A cairn made from stone, jade, and anima grass. Channels energy from the anima radix to empower colonists who meditate at the tree it is linked to. This cairn improves the mining capabilities of the meditator.</description>
		<graphicData>
			<texPath>TSOA/Things/Building/Cairn/AnimusCairnMining</texPath>
		</graphicData>
		<researchPrerequisites>
			<li>TSOA_AnimaOne</li>
		</researchPrerequisites>
		<modExtensions>
			<li Class="tsoa.core.CairnEffectExtension">
				<statOffsets>
					<MiningSpeed>0.1</MiningSpeed>
					<MiningYield>0.1</MiningYield>
				</statOffsets>
			</li>
		</modExtensions>
	</ThingDef>

