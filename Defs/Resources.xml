	<ThingDef ParentName="ResourceBase">
		<defName>TSOA_AnimaBark</defName>
		<label>anima bark</label>
		<description>A chunk of tough bark shed by an anima tree. The outside is as smooth as skin, but the inside is lined with mysterious patterns that seem to writhe when viewed from the corner of the eye. When held by psychically-sensitive individuals, the patterns glow faintly, seeming to react to their psychic presence. This makes it a valuable resource for crafting weapons and armor.</description>
		<graphicData>
			<texPath>TSOA/Things/Item/Resource/AnimaBark</texPath>
			<graphicClass>Graphic_StackCount</graphicClass>
		</graphicData>
		<soundInteract>Wood_Drop</soundInteract>
		<soundDrop>Wood_Drop</soundDrop>
		<stackLimit>50</stackLimit>
		<healthAffectsPrice>false</healthAffectsPrice>
		<statBases>
			<MaxHitPoints>70</MaxHitPoints>
			<MarketValue>63</MarketValue>
			<Mass>0.6</Mass>
			<Flammability>0.8</Flammability>
			<DeteriorationRate>2.0</DeteriorationRate>

			<StuffPower_Armor_Sharp>0.54</StuffPower_Armor_Sharp>
			<StuffPower_Armor_Blunt>0.54</StuffPower_Armor_Blunt>
			<StuffPower_Armor_Heat>0.40</StuffPower_Armor_Heat>
			<StuffPower_Insulation_Cold>8</StuffPower_Insulation_Cold>
			<StuffPower_Insulation_Heat>4</StuffPower_Insulation_Heat>
			<SharpDamageMultiplier>0.40</SharpDamageMultiplier>
			<BluntDamageMultiplier>0.9</BluntDamageMultiplier>
		</statBases>
