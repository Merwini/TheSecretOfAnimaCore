<Defs>
	<ThingDef ParentName="ResourceBase">
		<defName>TSOA_AnimaGrassResource</defName>
		<label>anima grass sheaf</label>
		<description>A bundled sheaf of anima grass. Harvested properly, the grass somehow remains alive, faintly humming with psychic resonance. It can be used in specialized crafting or ritual work.</description>
