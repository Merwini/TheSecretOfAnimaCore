<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>14.0</LangVersion>
    <RootNamespace>tsoa.core</RootNamespace>
    <AssemblyName>TheSecretOfAnimaCore</AssemblyName>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <OutputPath>../../1.6/Assemblies/</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <HarmonyAssemblyPath Condition="'$(HarmonyAssemblyPath)' == ''">$(MSBuildProjectDirectory)/../../../../../../workshop/content/294100/2009463077/Current/Assemblies/0Harmony.dll</HarmonyAssemblyPath>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="0Harmony">
      <HintPath>$(HarmonyAssemblyPath)</HintPath>
      <Private>false</Private>
    </Reference>
    <PackageReference Include="Krafs.Publicizer" Version="2.3.0" PrivateAssets="all" IncludeAssets="runtime; build; native; contentfiles; analyzers; buildtransitive" />
    <PackageReference Include="Krafs.Rimworld.Ref" Version="1.6.4633" PrivateAssets="all" />
    <Publicize Include="Assembly-CSharp" />
  </ItemGroup>

  <Target Name="ValidateHarmonyReference" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="!Exists('$(HarmonyAssemblyPath)')" Text="Harmony was not found at $(HarmonyAssemblyPath). Install the Harmony Steam Workshop mod (2009463077), or pass -p:HarmonyAssemblyPath=path/to/0Harmony.dll." />
  </Target>
</Project>
