<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <RootNamespace>tsoa.core</RootNamespace>
    <AssemblyName>TheSecretOfAnimaCore.Anomaly</AssemblyName>
    <TargetFrameworks>net48;net10.0</TargetFrameworks>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <LangVersion>14.0</LangVersion>
    <Deterministic>true</Deterministic>
    <RimWorldDir Condition="'$(RimWorldDir)' == ''">$(MSBuildProjectDirectory)/../../../..</RimWorldDir>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == 'net48'">
    <RimWorldVersion>1.6</RimWorldVersion>
  </PropertyGroup>
  <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <RimWorldVersion>1.7</RimWorldVersion>
  </PropertyGroup>
  <PropertyGroup Condition="'$(RimWorldVersion)' != ''">
    <OutputPath>../../Anomaly/$(RimWorldVersion)/Assemblies/</OutputPath>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <Optimize>true</Optimize>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../TheSecretOfAnimaCore/TheSecretOfAnimaCore.csproj" Private="false" />
    <PackageReference Include="Lib.Harmony" Version="2.4.2" />
    <PackageReference Include="Krafs.Publicizer" Version="2.3.0" PrivateAssets="all">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <Publicize Include="Assembly-CSharp" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <PackageReference Include="Krafs.Rimworld.Ref" Version="1.6.4871" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <Reference Include="Assembly-CSharp">
      <HintPath>$(RimWorldDir)/Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Waylith">
      <HintPath>$(RimWorldDir)/Waylith.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityStubs">
      <HintPath>$(RimWorldDir)/UnityStubs.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <Target Name="ValidateModReferences" BeforeTargets="ResolveReferences">
    <Error Condition="'$(TargetFramework)' == 'net10.0' And !Exists('$(RimWorldDir)/Assembly-CSharp.dll')" Text="RimWorld 1.7 assemblies not found. Set RimWorldDir to your RimWorld 1.7 installation using -p:RimWorldDir=... ." />
    <Error Condition="'$(TargetFramework)' == 'net10.0' And !Exists('$(RimWorldDir)/Waylith.dll')" Text="RimWorld 1.7 Waylith.dll not found. Set RimWorldDir to your RimWorld 1.7 installation using -p:RimWorldDir=... ." />
    <Error Condition="'$(TargetFramework)' == 'net10.0' And !Exists('$(RimWorldDir)/UnityStubs.dll')" Text="RimWorld 1.7 UnityStubs.dll not found. Set RimWorldDir to your RimWorld 1.7 installation using -p:RimWorldDir=... ." />
  </Target>
</Project>
